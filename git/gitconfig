[init]
	defaultBranch = main

[push]
	# デフォルトでpushするときに、現在のブランチを追跡する
	autoSetupRemote = true

[pull]
	# pullするときに、fast-forwardでないマージをするときはエラーにする
	ff = only

[grep]
	lineNumber = true

[core]
	# 日本語のファイル名やディレクトリ名の文字化けを防ぐ
	quotepath = false
	# ファイル名の大文字小文字を区別する
	ignorecase = false
	# 改行コードを自動で変換しない
	autocrlf = false

[alias]
	# よく使うコマンドのエイリアス
	# statusやcommitは二文字目まで入力しても他の候補があるので補完が効きにくい
	# そのため、短いエイリアスを設定して補完しやすくする
	s = status --short # shortの情報で十分な場合が多いため、--shortをデフォルトにする
	c = commit

[include]
	# マシンごとに異なる設定(user.name, user.email, 署名の有無など)を書くためのファイル
	# 共有マシンの共有アカウントでも本ファイルを読み込むため、個人のidentityや署名の設定は
	# 本ファイルに書かず、gitconfig.localに分離している(gitconfig.local.exampleを参照)
	# GIT_CONFIG_GLOBALで本ファイルを指定すると~/.gitconfigは読み込まれなくなるため、
	# identityを設定するには、gitconfig.localを作成する必要がある
	# ファイルが存在しない場合は、何も読み込まれずエラーにもならない
	path = gitconfig.local
